{
  "name": "ghayth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "npm run dev --workspace @agrix/web",
    "build": "npm run build --workspace @agrix/web && node scripts/build-web.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/web/tsconfig.node.json",
    "test": "node --test infrastructure/security/*.test.mjs",
    "check": "npm run typecheck && npm run test && npm run build",
    "cloudflare:install": "npm --prefix infrastructure/cloudflare ci",
    "cloudflare:check": "npm --prefix infrastructure/cloudflare run check",
    "cloudflare:dry-run": "npm --prefix infrastructure/cloudflare run dry-run",
    "cloudflare:deploy": "npm --prefix infrastructure/cloudflare run deploy"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
