# Copy to .env. Keep credentials outside Git. The launcher reads this as shell syntax.
DATABASE_URL=sqlite+pysqlite:///./data/ghayth.sqlite3
AGRIX_DEFAULT_ANALYSIS_MODE=live
AGRIX_REMOTE_ASSETS=1
AGRIX_PROVIDER_NETWORK=true
AGRIX_HLS_MAX_SCENES=10
# Without these overrides, the engine uses the last five completed calendar years.
# AGRIX_ANALYSIS_START=2021-01-01
# AGRIX_ANALYSIS_END=2025-12-31
AGRIX_ASR_MODEL=atlasia/moulsot.v0.3
AGRIX_ASR_BACKEND=qwen
AGRIX_TTS_MODEL=KandirResearch/DarijaTTS-v0.1-500M
AGRIX_TTS_BACKEND=kandir
AGRIX_DEVICE=auto
# Reduces CPU recognition RAM; use float32 if your CPU/model rejects bfloat16.
AGRIX_ASR_DTYPE=bfloat16
AGRIX_INFERENCE_TIMEOUT=170
HF_HOME=./data/models
# Set BOTH before public deployment:
# AGRIX_ENV=production
# AGRIX_ACCESS_PASSWORD=your-workspace-password
# AGRIX_SESSION_SECRET=a-stable-random-secret-at-least-32-characters-long
# PORT=8000

# Optional refreshed official economic data (see scripts/sync_economics.py):
# AGRIX_ECONOMICS_DATA=./data/economics.json
